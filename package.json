{
  "name": "feb-care",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3002",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node tests/integration.mjs",
    "worker": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/worker.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "lenis": "^1.3.26",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
