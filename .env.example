APP_URL=http://localhost:3002
# Production: set a managed PostgreSQL connection string and HTTPS APP_URL.
DATABASE_URL=
DATA_DIR=./data
STORAGE_DRIVER=local
# Optional private S3-compatible storage (Cloudflare R2 / Amazon S3).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Demonstration accounts and seed records are available in development only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional authenticated email relay. Receives JSON {to,subject,text,idempotencyKey}.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
